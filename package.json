{
  "name": "form-filler-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that remembers what you type into form fields (locally) and suggests it next time.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
